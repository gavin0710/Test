{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/access.js": {
      "includeFiles": "{index.html,analysis*.html,analysis*.js,analysis.css,analysis-data.json,lib/analysis-resources.cjs}"
    }
  },
  "routes": [
    {
      "src": "/api/latest",
      "dest": "/api/latest"
    },
    {
      "src": "/api/history",
      "dest": "/api/history"
    },
    {
      "src": "/(.*)",
      "dest": "/api/access?__path=$1"
    }
  ]
}
